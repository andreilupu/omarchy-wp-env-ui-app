#!/bin/bash
#
# wp-env-register-site <slug> ["Display Name"] [port]
#
# Creates $SITES_DIR/<slug>/.wp-env.json (auto-picking a free port pair
# unless one is given) and installs an Omarchy launcher entry that opens
# the site as an app-mode window via wp-env-launch.

set -euo pipefail

SITES_DIR="${WP_ENV_SITES_DIR:-$HOME/workspace/wordpress/omarchy/sites}"

script_dir="$(dirname "$(readlink -f "$0")")"
if [[ -f "$script_dir/../icons/wordpress.png" ]]; then
  default_icon="$script_dir/../icons/wordpress.png"
else
  default_icon="/usr/share/wp-env-ui/icons/wordpress.png"
fi
ICON_FILE="${WP_ENV_ICON:-$default_icon}"

slug="${1:-}"
[[ -n "$slug" ]] || { echo "Usage: wp-env-register-site <slug> [\"Display Name\"] [port]" >&2; exit 1; }
[[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "Slug must be lowercase alphanumeric/hyphens" >&2; exit 1; }

name="${2:-$slug}"
port="${3:-}"

site_dir="$SITES_DIR/$slug"
config="$site_dir/.wp-env.json"

# Pick the lowest free even port from 8888 up, skipping ports (and their
# tests ports) claimed by other sites' configs, by any project the control
# panel has discovered (its cached project list), or already listening on
# the machine.
if [[ -z "$port" ]]; then
  projects_cache="$HOME/.local/state/wp-env-ui/projects.json"
  used=$({
    cat "$SITES_DIR"/*/.wp-env.json 2>/dev/null |
      jq -r '.port // empty, .testsPort // empty' 2>/dev/null
    if [[ -f "$projects_cache" ]]; then
      jq -r '.[]' "$projects_cache" 2>/dev/null | while read -r proj; do
        cat "$proj/.wp-env.json" "$proj/.wp-env.override.json" 2>/dev/null
      done | jq -r '.port // empty, .testsPort // empty' 2>/dev/null
    fi
    ss -ltnH 2>/dev/null | awk '{n=split($4,a,":"); print a[n]}'
  } | grep -E '^[0-9]+$' | sort -n | uniq || true)
  port=8888
  while grep -qx "$port" <<<"$used" || grep -qx "$((port + 1))" <<<"$used"; do
    port=$((port + 2))
  done
fi
tests_port=$((port + 1))

if [[ -f "$config" ]]; then
  echo "Site '$slug' already exists ($config) — reinstalling launcher only."
  port=$(jq -r '.port // 8888' "$config")
else
  mkdir -p "$site_dir"
  jq -n --argjson port "$port" --argjson testsPort "$tests_port" \
    '{core: null, port: $port, testsPort: $testsPort}' >"$config"
  echo "Created $config (port $port, tests port $tests_port)"
fi

# Version-stable Exec target for the .desktop entry: the sibling script in
# this install, or the mise shim when installed through mise (the versioned
# install dir would break on upgrade).
if [[ "$script_dir" == *"/mise/"* ]]; then
  launch_bin="$HOME/.local/share/mise/shims/wp-env-launch"
else
  launch_bin="$script_dir/wp-env-launch"
fi
launch_cmd="$launch_bin $slug"
[[ -x "$launch_bin" ]] ||
  echo "Warning: $launch_bin not found — run install.sh / wp-env-ui-setup first." >&2

omarchy-webapp-install "$name" "http://localhost:$port" "$ICON_FILE" "$launch_cmd"

echo "Installed launcher '$name' — find it in the app launcher (SUPER + SPACE)."
