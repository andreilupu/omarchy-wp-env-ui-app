#!/bin/bash
#
# wp-env-stop <slug> | --all
#
# Stops one wp-env site (or every site under $SITES_DIR).

set -uo pipefail

SITES_DIR="${WP_ENV_SITES_DIR:-$HOME/workspace/wordpress/omarchy/sites}"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"

stop_site() {
  local dir="$1" slug
  slug=$(basename "$dir")
  echo "Stopping $slug…"
  if (cd "$dir" && npx @wordpress/env stop); then
    notify-send "wp-env" "Stopped $slug" 2>/dev/null
  else
    notify-send -u critical "wp-env" "Failed to stop $slug" 2>/dev/null
    return 1
  fi
}

case "${1:-}" in
  --all)
    rc=0
    for config in "$SITES_DIR"/*/.wp-env.json; do
      [[ -f "$config" ]] || continue
      stop_site "$(dirname "$config")" || rc=1
    done
    exit $rc
    ;;
  "")
    echo "Usage: wp-env-stop <slug> | --all" >&2
    exit 1
    ;;
  *)
    dir="$SITES_DIR/$1"
    [[ -f "$dir/.wp-env.json" ]] || { echo "No site '$1' under $SITES_DIR" >&2; exit 1; }
    stop_site "$dir"
    ;;
esac
