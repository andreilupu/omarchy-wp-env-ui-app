post_install() {
  cat <<'EOF'
  Finish setup for your user with:
    wp-env-ui-setup
  This enables the wp-env-ui systemd user service, installs the "wp-env"
  launcher entry, and copies the Omarchy bar widget into your config.
EOF
}

post_upgrade() {
  cat <<'EOF'
  Re-run `wp-env-ui-setup` to restart the server and sync the bar widget.
EOF
}
