{
  "schemaVersion": 1,
  "id": "wp-env-ui",
  "name": "wp-env",
  "version": "1.2.0",
  "author": "Andrei Lupu",
  "license": "MIT",
  "description": "Start, stop, and open wp-env WordPress sites from the Omarchy bar.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "wp-env",
    "description": "One bar icon and one panel: every wp-env project on the machine with favourites, live status, and start/stop/open controls.",
    "category": "Development",
    "aliases": ["wp-env", "wordpress"],
    "allowMultiple": false,
    "defaults": {
      "serverPort": 8710,
      "refreshIntervalSec": 10
    },
    "schema": [
      { "key": "serverPort", "type": "integer", "label": "Control panel port", "min": 1024, "max": 65535, "step": 1, "defaultValue": 8710 },
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 2, "max": 300, "step": 1, "defaultValue": 10 }
    ]
  }
}
